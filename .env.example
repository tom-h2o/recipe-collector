# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Service role key — used by /api functions only, never exposed to the browser
# Find in: Supabase dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_KEY=eyJ...

# ── Claude (main AI provider) ─────────────────────────────────────────────────
# Create a key in the Claude Console: https://platform.claude.com/settings/keys
# A Claude Max plan's monthly API credit covers it once a Console organisation
# is linked under claude.ai → Settings → Billing. Optional in the sense that
# the app still works without it: every task then runs on Gemini, the backup.
ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (backup provider, and recipe-search embeddings) ────────────────────
# Get keys from: https://aistudio.google.com/apikey
# The only key that is read. GEMINI_API_KEY_2 used to be listed here as an
# optional second key; nothing ever read it, so it has been removed rather
# than left to imply a failover that does not exist.
GEMINI_API_KEY_1=AIza...

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Get DSN from: Sentry dashboard → Project → Settings → Client Keys (DSN)
# Leave blank to disable error tracking in development
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_APP_ENV=development

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email of the admin user — shows the Admin tab and gates /api/admin access.
VITE_ADMIN_EMAIL=you@example.com

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Restrict /api endpoints to a specific origin. Defaults to * if unset.
# ALLOWED_ORIGIN=https://yourdomain.vercel.app
