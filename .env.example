# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Service role key — used by /api functions only, never exposed to the browser
# Find in: Supabase dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_KEY=eyJ...

# ── Claude (main AI provider) ─────────────────────────────────────────────────
# Create a key in the Claude Console: https://platform.claude.com/settings/keys
# A Claude Max plan's monthly API credit covers it once a Console organisation
# is linked under claude.ai → Settings → Billing. Optional in the sense that
# the app still works without it: every task then runs on Gemini, the backup.
ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (backup provider, and recipe-search embeddings) ────────────────────
# Get keys from: https://aistudio.google.com/apikey
# The only key that is read. GEMINI_API_KEY_2 used to be listed here as an
# optional second key; nothing ever read it, so it has been removed rather
# than left to imply a failover that does not exist.
GEMINI_API_KEY_1=AIza...

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Organization tom-enterprise. DSNs: Sentry → Settings → Projects → <project> →
# Client Keys (DSN). They are not secret. Leave blank to send nothing.
# speisekammer-web (the browser):
VITE_SENTRY_DSN=
# speisekammer-server (the /api functions):
SENTRY_DSN=
# Build only: uploads the browser source maps so stack traces are readable.
# An organization token (Sentry → Settings → Organization Tokens). Secret.
# Without it no source maps are made. Keep it out of the repository.
# SENTRY_AUTH_TOKEN=
# Optional override; otherwise production / preview comes from Vercel.
# VITE_APP_ENV=development

# ── Admin ─────────────────────────────────────────────────────────────────────
# The admin's account id (Supabase dashboard → Authentication → Users → the
# user's UID). Server only: the app asks /api/account?tab=whoami whether the
# signed-in person is the admin. Until it is set, ADMIN_EMAIL (or the older
# VITE_ADMIN_EMAIL) is used instead, and only once that address is confirmed.
ADMIN_USER_ID=
# ADMIN_EMAIL=you@example.com

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Restrict /api endpoints to a specific origin. Defaults to * if unset. No
# request needs credentials (sign-in is a header, not a cookie).
# ALLOWED_ORIGIN=https://yourdomain.vercel.app
